# Profiles started by a plain `docker compose up` (add observability,ci for the stretch stack)
COMPOSE_PROFILES=core

# Copy to .env and fill in. Never commit .env.

# Image tag (Jenkins sets this to the build number)
TAG=local
REGISTRY=localhost:5000

# WSO2 versions: must match the zips in dist/
MI_VERSION=4.3.0
APIM_VERSION=4.4.0
# Optional MI Dashboard (--profile dashboard): wso2mi-dashboard-<version>.zip in dist/
MI_DASHBOARD_VERSION=4.2.0
# WSO2 MI/APIM start scripts accept JDK 11-17 only; everything else uses JDK 21
WSO2_JAVA_BASE_IMAGE=eclipse-temurin:17-jre
JAVA_BASE_IMAGE=eclipse-temurin:21-jre

# APIM admin (changed from the default)
APIM_ADMIN_USER=admin
APIM_ADMIN_PASSWORD=change-me

# H2 accounts database
H2_DB_NAME=jamii
H2_USER=jamii_app
H2_PASSWORD=change-me
# Recreate the database from schema + seed on every start (synthetic data)
H2_RESET_ON_START=true

# Backends: Jamii mock backends (Spring Boot), built and deployed separately.
# On the shared Docker network use the container name; elsewhere use the deployed host.
CUSTOMER_BACKEND_URL=http://jamii-mock-backends:8080
CREDIT_BACKEND_URL=http://jamii-mock-backends:8080/ws

# Stretch: ELK (pin all four Elastic components to the same version)
ELASTIC_VERSION=8.x.y
ELASTIC_PASSWORD=change-me

# Jenkins (profile ci): admin login; JAMII_REPO_URL defaults to the mounted repo (file:///src)
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me
# JAMII_REPO_URL=https://github.com/<your-username>/<your-repo>.git   (replace both placeholders)
# JAMII_REPO_BRANCH=*/main
# Private repo only: a fine-grained personal access token with read-only Contents access
# GITHUB_USER=<your-username>
# GITHUB_TOKEN=<token>

# VPS only: public names behind nginx (leave unset locally)
# APIM_HOSTNAME=portal.jamii.daqiqtech.co.ke
# GATEWAY_HOSTNAME=api.jamii.daqiqtech.co.ke
# PUBLIC_APIM_URL=https://portal.jamii.daqiqtech.co.ke
# PUBLIC_GATEWAY_URL=https://api.jamii.daqiqtech.co.ke
# JENKINS_URL=https://jenkins.jamii.daqiqtech.co.ke/
# APIM_SELF_ADDRESS=host-gateway
